{
  "name": "topaz",
  "version": "0.0.0",
  "description": "TypeScript-syntax AOT native compiler",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "topaz": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "scripts": {
    "build": "tsc",
    "build:release": "bash scripts/build-release.sh",
    "check:runtime-header": "node scripts/generate-runtime-header.mjs --check",
    "check:runtime-prelude": "node scripts/generate-runtime-prelude.mjs --check",
    "check:runtime-substrate": "node scripts/check-runtime-substrate.mjs",
    "check:builtin-effects": "node scripts/check-builtin-effects.mjs",
    "check:effect-provenance": "node scripts/check-effect-provenance.mjs",
    "check:effect-report": "node scripts/check-effect-report.mjs",
    "check:effect-selfhost": "node scripts/check-effect-selfhost.mjs",
    "generate:runtime-header": "node scripts/generate-runtime-header.mjs",
    "generate:runtime-prelude": "node scripts/generate-runtime-prelude.mjs",
    "bench": "node scripts/bench.mjs",
    "topaz": "node dist/cli.js",
    "test": "bash tests/smoke.sh",
    "test:selfhost": "bash tests/selfhost_fixed_point.sh"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
